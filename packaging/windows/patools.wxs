<?xml version="1.0" encoding="utf-8"?>
<!--
  Pa Tools MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build patools.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.scraft` sessions owned by
  Pa Tools, and Pa Tools offered under "Open with" for WAV/AIFF/FLAC/MP3 and MIDI files
  (without taking over the user's default player for them).

  UpgradeCode and the component GUIDs are Pa Tools' own (not upstream SoundCraft's): they must never change
  once a release is out, or Windows treats the next MSI as a different product.
  The ARP links point at the placeholder homepage (rebrand.sh HOMEPAGE).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Pa Tools"
      Manufacturer="GR8 ID YUZ.AI"
      Version="$(var.Version)"
      UpgradeCode="1DEA60C7-CB3B-4232-ACD0-EA511738486C"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Pa Tools digital audio workstation" Manufacturer="GR8 ID YUZ.AI" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Pa Tools is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="PaToolsIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PaToolsIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://gr8idyuz.ai" />
    <Property Id="ARPURLUPDATEINFO" Value="https://gr8idyuz.ai" />
    <Property Id="ARPHELPLINK" Value="https://gr8idyuz.ai" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Pa Tools" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Pa Tools" Level="1">
      <ComponentGroupRef Id="PaToolsFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PaToolsFiles" Directory="INSTALLFOLDER">
      <Component Id="PaToolsApp" Guid="25BA2EB1-CD2E-4DB8-B520-00CED2E479BF">
        <File Id="PaToolsExe" Source="$(var.BinDir)\pa-tools.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Pa Tools"
              Description="Pa Tools digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="PaToolsIcon.ico" IconIndex="0" />
        </File>

        <!-- .scraft: the session format (inherited from SoundCraft); Pa Tools is its default app. -->
        <ProgId Id="PaTools.Session" Description="Pa Tools Session" Icon="PaToolsExe" IconIndex="0">
          <Extension Id="scraft" ContentType="application/x-patools-session">
            <Verb Id="open" Command="Open" TargetFile="PaToolsExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="PaTools.Audio" Description="Audio File" Icon="PaToolsExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\PaTools.Audio\shell\open\command" Value="&quot;[#PaToolsExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="PaTools.Midi" Description="MIDI File" Icon="PaToolsExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\PaTools.Midi\shell\open\command" Value="&quot;[#PaToolsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.wav\OpenWithProgids" Name="PaTools.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aif\OpenWithProgids" Name="PaTools.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aiff\OpenWithProgids" Name="PaTools.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.flac\OpenWithProgids" Name="PaTools.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mp3\OpenWithProgids" Name="PaTools.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mid\OpenWithProgids" Name="PaTools.Midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.midi\OpenWithProgids" Name="PaTools.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "pa-tools"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe" Name="FriendlyAppName" Value="Pa Tools" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\shell\open\command" Value="&quot;[#PaToolsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".scraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pa-tools.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\pa-tools.exe" Value="[#PaToolsExe]" Type="string" />
      </Component>

      <Component Id="PaToolsCli" Guid="2F54EF9E-F070-4066-BAEF-88D40768AD82">
        <File Id="PaToolsCliExe" Source="$(var.BinDir)\pa-tools-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
