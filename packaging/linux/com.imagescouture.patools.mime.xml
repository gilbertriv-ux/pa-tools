<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for Pa Tools' session format (the .scraft extension is inherited
     from SoundCraft, so sessions open in both). Audio and MIDI types come from the system database.
     Installed to /usr/share/mime/packages/ (update-mime-database runs on install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-patools-session">
    <comment>Pa Tools session</comment>
    <sub-class-of type="application/json"/>
    <icon name="com.imagescouture.patools"/>
    <glob pattern="*.scraft"/>
  </mime-type>
</mime-info>
